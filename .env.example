# Copia este archivo como ".env" (en la raíz) y cambia los valores. NUNCA subas el .env a GitHub.

# ---- Seguridad JWT ----
# Secreto con el que se FIRMA y se VALIDA el token. Debe ser el MISMO para el Gateway y los 3 microservicios
# (por eso está en un único .env en la raíz). Usa algo largo y aleatorio.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
# Duración del token (ej: 12h, 30m). Para demostrar la expiración en clase puedes poner 20s.
JWT_EXPIRES_IN=12h

# ---- Puertos ----
GATEWAY_PORT=3000
USUARIOS_PORT=3001
COMPETENCIA_PORT=3002
INSCRIPCIONES_PORT=3003

# ---- Direcciones de los microservicios (las usan el Gateway y las llamadas entre servicios) ----
USUARIOS_URL=http://localhost:3001
COMPETENCIA_URL=http://localhost:3002
INSCRIPCIONES_URL=http://localhost:3003

# ---- Usuarios iniciales (se crean solo la primera vez, en ms-usuarios) ----
# Administrador (organización de la liga): único que puede editar, eliminar, aprobar equipos y registrar resultados.
# Delegado (representante de un equipo): inscribe su equipo y sus jugadores y consulta torneos y posiciones.
# Cambia estas claves antes de publicar el proyecto en internet.
ADMIN_USERNAME=leomontes
ADMIN_PASSWORD=LeoMontes77-Admin
DELEGADO_USERNAME=delegado
DELEGADO_PASSWORD=LeoMontes77-Delegado
